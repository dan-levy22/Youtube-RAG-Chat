# requirements.in

# Backend Framework & Server
fastapi
uvicorn[standard]
python-dotenv

# Database & Data Models
sqlmodel
psycopg2-binary # Postgres driver

# LangChain & AI Components
langchain-community
langchain-google-genai
langchain-chroma  # Wrapper for ChromaDB integration
langchain
langchain-yt-dlp    # Alternate langchain loader based on yt-dlp
yt-dlp
youtube-transcript-api
pypdf             # For document processing, likely used by LangChain
chromadb

# Frontend
streamlit
requests          # For making API calls from Streamlit to FastAPI

# --- Development & Testing ---
# Add a new line and "-c requirements.in" to your pip-compile command
# to separate dev dependencies. For now, we'll keep it simple.

pytest
flake8            # Add the linter for your CI pipeline
autoflake
isort
mypy